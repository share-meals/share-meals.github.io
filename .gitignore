# build output
dist/
# generated types
.astro/

# dependencies
node_modules/
# Yarn's local resolution cache. Regenerated on every install and pinned by
# nothing — yarn.lock is the file that actually fixes versions. Tracking it
# just puts a 340KB binary diff in every dependency change.
.yarn/install-state.gz

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local agent tooling — launch configs point at whatever port happens to be
# free on one machine, so they are not shared state
.claude/
