---
/**
 * NAV APPROACH — deliberate, worth reading before "adding a hamburger".
 *
 * The links are always visible and wrap onto a second row on small screens.
 * There is no toggle, which means no JavaScript, no focus trapping, no ARIA
 * expanded state, and nothing to break. For a handful of short links this is
 * also better UX than hiding them behind a tap.
 *
 * The no-JS `<details>` disclosure pattern was considered and rejected: closed
 * `<details>` content is hidden by the UA in a way CSS cannot reliably override
 * at desktop widths, so it forces either duplicated nav markup or JavaScript.
 *
 * If the nav grows past ~6 items, revisit — that is the point where a
 * disclosure earns its complexity.
 *
 * EMPTY ON PURPOSE. The previous items mirrored the old site's structure and
 * were removed with their pages; the information architecture is being decided
 * from scratch. The rendering below is kept and handles the empty case, so
 * adding a section back means adding one entry here and nothing else.
 */
const links: { label: string; href: string }[] = [];

// Normalized so '/x' and '/x/' both mark the nav item as current.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
  <div
    class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-5 py-4 sm:px-8"
  >
    {/* Logomark plus wordmark in one link, so there is a single target rather
        than two adjacent links to the same place.

        The image is alt="" on purpose. The link already reads "Share Meals"
        from its text, and giving the mark its own alt would make a screen
        reader announce the name twice. The mark is decorative *here*
        specifically because the text is next to it. */}
    <a
      href="/"
      class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight text-[var(--color-brand-700)] no-underline"
    >
      <img
        src="/logomark.svg"
        alt=""
        width="40"
        height="40"
        class="h-10 w-10 shrink-0"
      />
      Share Meals
    </a>

    {/* Rendered only when there is something in it — an empty landmark is
        noise for screen reader users, not a neutral placeholder. */}
    {links.length > 0 && (
    <nav aria-label="Main" class="order-3 w-full sm:order-2 sm:w-auto">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 p-0 m-0 list-none">
        {
          links.map((link) => {
            const isCurrent = here === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  class:list={[
                    'text-[var(--color-text)] no-underline hover:text-[var(--color-brand-700)]',
                    isCurrent &&
                      'font-semibold text-[var(--color-brand-700)] underline underline-offset-4',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    )}
  </div>
</header>
