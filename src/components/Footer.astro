---
/**
 * The legal name "Share Meals United" belongs here and in other legal contexts.
 * Everywhere else in the site the brand name is "Share Meals".
 *
 * PLACEHOLDER: contact details and the exact legal/tax line are content
 * decisions and are intentionally not invented here.
 */
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]">
  <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8">
    <p class="text-2xl font-extrabold tracking-tight m-0">Share Meals</p>

    <nav aria-label="Footer" class="mt-8">
      <ul class="flex flex-wrap gap-x-8 gap-y-3 p-0 m-0 list-none">
        <li><a class="text-inherit underline underline-offset-4" href="/initiatives">Initiatives</a></li>
        <li><a class="text-inherit underline underline-offset-4" href="/press">Press</a></li>
        <li><a class="text-inherit underline underline-offset-4" href="/contact">Contact</a></li>
        <li><a class="text-inherit underline underline-offset-4" href="/donate">Donate</a></li>
      </ul>
    </nav>

    <p class="mt-10 text-sm opacity-90 m-0">
      &copy; {year} Share Meals United. <!-- TODO(content): confirm the exact
      legal / tax-status line before launch rather than assuming it. -->
    </p>
  </div>
</footer>
