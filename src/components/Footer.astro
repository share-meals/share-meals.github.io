    <p class="text-2xl font-extrabold tracking-tight m-0">Share Meals</p>

    <p class="mt-10 text-sm opacity-90 m-0">
      &copy; {year} Share Meals United. <!-- TODO(content): confirm the exact
      legal / tax-status line before launch rather than assuming it. -->
    </p>
  </div>
</footer>
