---
/**
 * Full-width band with a constrained inner column.
 *
 * The design direction leans on full-bleed color blocks, so the band and its
 * content width are separated here rather than being re-solved per page.
 */
interface Props {
  /** Background treatment. `inverse` flips to brand green with white text. */
  tone?: 'default' | 'muted' | 'inverse';
  /** Vertical rhythm. `hero` is the oversized opening band. */
  size?: 'default' | 'tight' | 'hero';
  class?: string;
  /** Rendered element. Use `div` when the section is not a landmark. */
  as?: 'section' | 'div' | 'header' | 'footer';
  id?: string;
  /** Hide the whole band. For content a script reveals once it has data. */
  hidden?: boolean;
}

// Explicitly annotated: the dynamic `as: Tag` destructure defeats Astro's
// automatic Props inference, leaving `tone` and `size` as `any` and silently
// dropping type safety on the token lookups below.
const {
  tone = 'default',
  size = 'default',
  class: className = '',
  as: Tag = 'section',
  id,
  hidden = false,
}: Props = Astro.props;

// Only AA-cleared pairings — see the legal set at the bottom of global.css.
const tones = {
  default: 'bg-[var(--color-surface)] text-[var(--color-text)]',
  muted: 'bg-[var(--color-surface-muted)] text-[var(--color-text)]',
  inverse: 'bg-[var(--color-surface-inverse)] text-[var(--color-text-inverse)]',
};

const sizes = {
  tight: 'py-10 md:py-14',
  default: 'py-16 md:py-24',
  hero: 'py-20 md:py-32',
};
---

<Tag id={id} hidden={hidden} class={`${tones[tone]} ${sizes[size]} ${className}`}>
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <slot />
  </div>
</Tag>
