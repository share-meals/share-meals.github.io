---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/Section.astro';
import Button from '~/components/Button.astro';

/**
 * APP SUPPORT — /app/support
 *
 * The support URL on the App Store listing, and the one to give Google Play.
 * Apple requires it to lead to real contact information, and its reviewers
 * may follow it, so the email address is the first thing on the page rather
 * than something to scroll for.
 *
 * WHAT IS NOT HERE, ON PURPOSE.
 *
 * Troubleshooting answers. Anything written here about how verification or
 * notifications behave is a claim about the app, and it goes stale the moment
 * the app changes without anyone remembering this page. Add them when someone
 * who owns the app can vouch for them — not before.
 */
const supportEmail = 'nucleus@sharemeals.org';
---

<BaseLayout
  title="App support"
  description="Get help with the Share Meals app. Email us with your question and we'll get back to you."
>
  <Section size="hero">
    <h1 class="text-display-xl font-extrabold text-balance m-0">App support</h1>

    <p class="text-lead mt-8 max-w-2xl">
      Need help with the Share Meals app? Email us and we'll get back to you.
    </p>
    <a href={`mailto:${supportEmail}`} class="support-email text-lead mt-4 inline-block">{supportEmail}</a>
  </Section>

  <Section tone="muted">
    <h2 class="text-display font-extrabold text-balance m-0">What to include</h2>
    <p class="text-lead mt-6 max-w-2xl">
      A few details help us sort out the problem faster:
    </p>
    <ul class="text-lead mt-4 max-w-2xl list-disc pl-6">
      <li>Your college or university</li>
      <li>Whether you use the app on an iPhone, an Android phone or in a web browser</li>
      <li>What you were trying to do, and what happened instead</li>
      <li>A screenshot, if you can take one</li>
    </ul>
  </Section>

  <Section>
    <h2 class="text-display font-extrabold text-balance m-0">New to the app?</h2>
    <p class="text-lead mt-6 max-w-2xl">
      Find out what the app does, and how to get it on your phone or use it in
      any browser.
    </p>
    <p class="mt-8 m-0">
      <Button href="/app" variant="secondary">About the Share Meals app</Button>
    </p>
  </Section>
</BaseLayout>

<style>
  .support-email {
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
