# Copy to `.env` for local development. `.env` is gitignored.

# Base URL of the Directus backend, with no trailing path.
#
# Used by the impact-numbers band on the home page, which calls
# `${PUBLIC_DIRECTUS_URL}/public-stats` from the browser. The endpoint is
# public and unauthenticated, so this is not a secret — the value is compiled
# into a script every visitor downloads.
#
# LEAVING THIS UNSET IS FINE. The band is then left out of the build entirely,
# and the rest of the page is unaffected. Set it only when you have a host that
# actually serves `/public-stats`.
#
# In CI and on deploy this comes from the `PUBLIC_DIRECTUS_URL` repository
# variable (Settings → Secrets and variables → Actions → Variables).
PUBLIC_DIRECTUS_URL=
